{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
    	"key": {
    		"width": 11
    	},
    	"disableLinewrap": true,
    	"separator": ":"
    },
    "logo": {
        "type": "file-raw",
        "source": "~/.config/fastfetch/logo.txt",
        "padding": {
        	"top": 2,
            "left": 1,
            "right": 5
        }
    },
    "modules": [
        {
            "type": "custom",
            "format": "{#38;2;156;109;237}H{#38;2;165;122;240}a{#38;2;173;135;242}r{#38;2;182;148;245}d{#38;2;191;161;247}w{#38;2;200;174;250}a{#38;2;208;187;252}r{#38;2;217;200;255}e{#0}"
        },
        {
            "type": "custom",
            "format": "{#38;2;156;109;237}─{#38;2;166;124;240}─{#38;2;176;139;243}─{#38;2;186;154;246}─{#38;2;197;170;249}─{#38;2;207;185;252}─{#38;2;217;200;255}─{#0}"
        },
        {
            "type": "host",
            "key": " PC",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": " CPU",
            "keyColor": "green",
            "format": "{1}"
        },
        {
            "type": "gpu",
            "key": "󰍛 GPU",
            "keyColor": "green",
            "format": "{2}"
        },
        {
            "type": "memory",
            "key": "󰍛 RAM",
            "keyColor": "green"
        },
        {
            "type": "command",
            "key": " Disk",
            "keyColor": "green",
            "color": "green",
            "text": "df -h / | awk 'NR==2 {printf \"%.1fGiB / %.1fGiB (%s)\", $3, $2, $5}'"
        },
        {
            "type": "display",
            "key": "󰍹 Display",
            "keyColor": "green",
            "format": "{width}x{height} @ {refresh-rate}Hz"
        },
        "break",
        {
            "type": "custom",
            "format": "{#38;2;156;109;237}S{#38;2;165;122;240}o{#38;2;173;135;242}f{#38;2;182;148;245}t{#38;2;191;161;247}w{#38;2;200;174;250}a{#38;2;208;187;252}r{#38;2;217;200;255}e{#0}"
        },
        {
            "type": "custom",
            "format": "{#38;2;156;109;237}─{#38;2;166;124;240}─{#38;2;176;139;243}─{#38;2;186;154;246}─{#38;2;197;170;249}─{#38;2;207;185;252}─{#38;2;217;200;255}─{#0}"
        },
        {
            "type": "os",
            "key": " OS",
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": " WM",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": " Term",
            "keyColor": "blue"
        },
        "break",
        {
            "type": "custom",
            "format": "{#38;2;156;109;237}S{#38;2;162;118;239}y{#38;2;168;127;241}s{#38;2;174;136;242}t{#38;2;180;145;244}e{#38;2;186;154;246}m {#38;2;199;173;250}I{#38;2;205;182;251}n{#38;2;211;191;253}f{#38;2;217;200;255}o{#0}"
        },
        {
            "type": "custom",
            "format": "{#38;2;156;109;237}─{#38;2;162;118;239}─{#38;2;168;127;241}─{#38;2;174;136;242}─{#38;2;180;145;244}─{#38;2;186;154;246}─{#38;2;193;164;248}─{#38;2;199;173;250}─{#38;2;205;182;251}─{#38;2;211;191;253}─{#38;2;217;200;255}─{#0}"
        },
        {
            "type": "command",
            "key": " OS Age",
            "keyColor": "magenta",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": " Uptime",
            "keyColor": "magenta"
        },
        {
            "type": "command",
            "key": "󰚰 Updated",
            "keyColor": "magenta",
            "text": "t=$(grep 'starting full system upgrade' /var/log/pacman.log | tail -1 | sed -E 's/^\\[([^]]+)\\].*/\\1/'); echo $(( ($(date +%s) - $(date -d \"$t\" +%s)) / 86400 )) days ago"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
